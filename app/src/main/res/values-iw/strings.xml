    <!-- Vaccine Descriptions -->
    <string name="vaccine_desc_rabies_cat">חיסון חיוני לחתולים שיוצאים החוצה. כלבת היא מחלה ויראלית קטלנית שיכולה להיות מועברת לבני אדם. נדרשת חיסון שנתי. מגן מפני וירוס קטלני זה הפוגע במערכת העצבים.</string>
    <string name="vaccine_desc_rabies_dog">חיסון חיוני לכל הכלבים. כלבת היא מחלה ויראלית קטלנית שיכולה להיות מועברת לבני אדם. מנה ראשונה כוללת השתלת שבב. נדרש על פי החוק הישראלי. מגן מפני וירוס קטלני זה הפוגע במערכת העצבים.</string>
    <string name="vaccine_desc_quadrivalent">מגן מפני 4 מחלות: פנליאוקופניה, הרפסוירוס, קליציווירוס וכלמידיה.</string>
    <string name="vaccine_desc_felv">מומלץ לחתולים שיוצאים החוצה. מונע זיהום ויראלי שמחליש את מערכת החיסון, מה שהופך חתולים לפגיעים למחלות אחרות.</string>
    <string name="vaccine_desc_hexavalent">מגן מפני 6 מחלות: וירוס הדיסטמפר של כלבים (CDV), אדנווירוס כלבים סוג 2 (CAV-2), פרוווירוס כלבים (CPV), לפטוספירוזיס (שני סרוטיפים), וירוס הפרה-אינפלואנזה של כלבים (CPiV) וקורונה של כלבים (CCV).</string>
    <string name="vaccine_desc_spirocerca">מונע זיהום על ידי תולעת טפילית נפוצה בישראל, שיכולה לגרום למחלה קשה, כולל גידולים בוושט.</string>
    <string name="vaccine_desc_parkworm">מונע התקפה על ידי תולעת טפילית המועברת דרך חיפושיות.</string>
    <string name="vaccine_desc_kennel_cough">מגן מפני שיעול המלונה, זיהום נשימתי קל.</string>
    <string name="vaccine_desc_fleas_ticks_cat">מגן מפני פרעושים וקרציות, מונע גירוד חמור, תגובות אלרגיות והעברת מחלות (למשל, המוברטונלוזיס).</string>
    <string name="vaccine_desc_fleas_ticks_dog">מגן מפני התקפות שגורמות לגירוי עור, אנמיה והעברת מחלות (למשל, ארליכיוזיס מקרציות).</string>
    <string name="vaccine_desc_internal_parasites_cat">מונע תולעים מעיים שיכולות לגרום לירידה במשקל, הקאות ושלשול.</string>
    <string name="vaccine_desc_internal_parasites_dog">מונע תולעים עגולות, תולעי סרט, תולעי קרס ותולעים מעיים אחרות.</string>

